<?xml version="1.0"?>
<model>
  <name>gedung_P</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>

  <author>
    <name>ORBIT Team</name>
    <email>developer@orbit.local</email>
  </author>

  <description>
    High-fidelity 3D simulation model for Gedung P Lantai 3 (Telkom University).
    Footprint span: 97m x 34.2m. Wall height: 4.0m.
    Features 80cm low walls with 144cm wide panoramic windows on rect5838 south, rect5838-3 south,
    rect2200, rect2200-6, rect325 east, and rect325-5 west. Solid 4m walls on rect325 west and rect325-5 east.
  </description>
</model>
