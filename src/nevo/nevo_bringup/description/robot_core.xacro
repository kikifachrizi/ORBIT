<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >

    <xacro:include filename="inertial_macros.xacro"/>

    <xacro:property name="mesh_scale" value="0.001 0.001 0.001"/>

    <material name="white">
        <color rgba="1 1 1 1"/>
    </material>
    <material name="orange">
        <color rgba="1 0.3 0.1 1"/>
    </material>
    <material name="blue">
        <color rgba="0.2 0.2 1 1"/>
    </material>
    <material name="black">
        <color rgba="0 0 0 1"/>
    </material>
    <material name="red">
        <color rgba="1 0 0 1"/>
    </material>

    <link name="base_link">
    </link>

    <joint name="base_footprint_joint" type="fixed">
        <parent link="base_link"/>
        <child link="base_footprint"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="base_footprint">
    </link>

    <joint name="chassis_joint" type="fixed">
        <parent link="base_link"/>
        <child link="chassis"/>
        <origin xyz="-0.315 0.0 0.0"/>
    </joint>

    <link name="chassis">
        <visual>
            <origin xyz="0.315 0.0 0.065" rpy="0.0 0.0 1.57"/>
            <geometry>
                <mesh filename="package://nevo_bringup/meshes/body_urdf.stl" scale="${mesh_scale}"/>
            </geometry>
            <material name="white"/>
        </visual>
        <collision>
            <origin xyz="0.315 0.0 0.065" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="0.63 0.53 0.12"/>
            </geometry>
        </collision>
        <xacro:inertial_box mass="5.0" x="0.63" y="0.53" z="0.12">
            <origin xyz="0.315 0.0 0.065" rpy="0.0 0.0 0.0"/>
        </xacro:inertial_box>
    </link>
    <gazebo reference="chassis">
        <visual>
            <material>
                <ambient>1 1 1 1</ambient>
                <diffuse>1 1 1 1</diffuse>
                <specular>0.5 0.5 0.5 1</specular>
            </material>
        </visual>
    </gazebo>

    <joint name="left_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="left_wheel"/>
        <origin xyz="0.0 0.2125 0.0635" rpy="-${pi/2} 0 0"/>  <!-- wheel_separation 0.425 m (measured 42 cm), same as diff_cont -->
        <axis xyz="0.0 0.0 1.0"/>
    </joint>

    <link name="left_wheel">
        <visual>
            <origin xyz="0 0 0.14" rpy="0 1.57 0"/>
            <geometry>
                <mesh filename="package://nevo_bringup/meshes/left_wheel_urdf.stl" scale="${mesh_scale}"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.0635" length="0.024"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="0.5" length="0.024" radius="0.0635">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>
    <gazebo reference="left_wheel">
        <visual>
            <material>
                <ambient>0.2 0.2 1 1</ambient>
                <diffuse>0.2 0.2 1 1</diffuse>
                <specular>0.5 0.5 0.5 1</specular>
            </material>
        </visual>
        <mu1>200.0</mu1>
        <mu2>200.0</mu2>
        <kp>10000000.0</kp> 
        <kd>1.0</kd>
        <minDepth>0.001</minDepth>
        <maxVel>1.0</maxVel>
        <fdir1>1 0 0</fdir1>
    </gazebo>

    <joint name="right_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="right_wheel"/>
        <origin xyz="0.0 -0.2125 0.0635" rpy="${pi/2} 0 0"/>
        <axis xyz="0.0 0.0 -1.0"/>
    </joint>

    <link name="right_wheel">
        <visual>
            <origin xyz="0 0 -0.26" rpy="0 1.57 0"/>
            <geometry>
                <mesh filename="package://nevo_bringup/meshes/right_wheel_urdf.stl" scale="${mesh_scale}"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.0635" length="0.024"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="0.5" length="0.024" radius="0.0635">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>
    <gazebo reference="right_wheel">
        <visual>
            <material>
                <ambient>0.2 0.2 1 1</ambient>
                <diffuse>0.2 0.2 1 1</diffuse>
                <specular>0.5 0.5 0.5 1</specular>
            </material>
        </visual>
        <mu1>200.0</mu1>
        <mu2>200.0</mu2>
        <kp>10000000.0</kp> 
        <kd>1.0</kd>
        <minDepth>0.001</minDepth>
        <maxVel>1.0</maxVel>
        <fdir1>1 0 0</fdir1>
    </gazebo>

    <joint name="rear_caster_wheel_joint" type="fixed">
        <parent link="chassis"/>
        <child link="rear_caster_wheel"/>
        <origin xyz="0.56 0.0 0.05"/>
    </joint>
    
    <link name="rear_caster_wheel">
        <visual>
            <origin xyz="0 0 -0.03" rpy="0 0 0"/>
            <geometry>
                <sphere radius="0.02"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <origin xyz="0 0 -0.03" rpy="0 0 0"/>
            <geometry>
                <sphere radius="0.02"/>
            </geometry>
        </collision>
        <xacro:inertial_sphere mass="0.1" radius="0.02">
            <origin xyz="0.0 0.0 -0.03" rpy="0.0 0.0 0.0"/>
        </xacro:inertial_sphere>
    </link>
    <gazebo reference="rear_caster_wheel">
        <visual>
            <material>
                <ambient>0.1 0.1 0.1 1</ambient>
                <diffuse>0.1 0.1 0.1 1</diffuse>
                <specular>0.2 0.2 0.2 1</specular>
            </material>
        </visual>
        <mu1>0.0</mu1>
        <mu2>0.0</mu2>
        <kp>1000000.0</kp>
        <kd>100.0</kd>
        <minDepth>0.001</minDepth>
        <maxVel>0.1</maxVel>
    </gazebo>

    <joint name="back_caster_wheel_joint" type="fixed">
        <parent link="chassis"/>
        <child link="back_caster_wheel"/>
        <origin xyz="0.07 0.0 0.05"/>
    </joint>
    
    <link name="back_caster_wheel">
        <visual>
            <origin xyz="0 0 -0.03" rpy="0 0 0"/>
            <geometry>
                <sphere radius="0.02"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <origin xyz="0 0 -0.03" rpy="0 0 0"/>
            <geometry>
                <sphere radius="0.02"/>
            </geometry>
        </collision>
        <xacro:inertial_sphere mass="0.1" radius="0.02">
            <origin xyz="0.0 0.0 -0.03" rpy="0.0 0.0 0.0"/>
        </xacro:inertial_sphere>
    </link>
    <gazebo reference="back_caster_wheel">
        <visual>
            <material>
                <ambient>0.1 0.1 0.1 1</ambient>
                <diffuse>0.1 0.1 0.1 1</diffuse>
                <specular>0.2 0.2 0.2 1</specular>
            </material>
        </visual>
        <mu1>0.0</mu1>
        <mu2>0.0</mu2>
        <kp>1000000.0</kp>
        <kd>100.0</kd>
        <minDepth>0.001</minDepth>
        <maxVel>0.1</maxVel>
    </gazebo>

</robot>
