<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tifa_bringup</name>
  <version>0.0.0</version>
  <description>TODO: Package description</description>
  <maintainer email="kiki@todo.todo">kiki</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>geometry_msgs</depend>
  <depend>nav2_msgs</depend>
  <!-- [JAZZY] key rosdep yang benar (nlohmann_json tidak punya rule rosdep) -->
  <depend>nlohmann-json-dev</depend>
  <depend>std_msgs</depend>
  <depend>lifecycle_msgs</depend>

  <!-- find_package(PostgreSQL) butuh header saat build -->
  <depend>libpq-dev</depend>

  <!-- Runtime: node yang dijalankan oleh launch file tifa_bringup,
       supaya "rosdep install" memasang semuanya di Jazzy -->
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>diff_drive_controller</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>twist_mux</exec_depend>
  <exec_depend>laser_filters</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>navigation2</exec_depend>
  <exec_depend>nav2_common</exec_depend>
  <exec_depend>diffdrive_arduino</exec_depend>
  <exec_depend>rplidar_ros</exec_depend>
  <exec_depend>rf2o_laser_odometry</exec_depend>
  <exec_depend>tifa_ws_bridge</exec_depend>
  <exec_depend>tifa_diagnostic_node</exec_depend>
  <exec_depend>tifa_robot_api</exec_depend>

  <!-- Simulasi (tifa_sim.launch.py) -->
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>gz_ros2_control</exec_depend>
  <exec_depend>teleop_twist_keyboard</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
