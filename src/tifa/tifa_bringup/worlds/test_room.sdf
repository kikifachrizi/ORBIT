<?xml version="1.0" ?>
<!-- World uji robot sendirian (bukan site). Ruang 8 x 6 m dengan dua kotak supaya
     lidar dan rf2o punya pantulan. World site ada di orbit_sim. -->
<sdf version="1.9">
  <world name="test_room">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Daftar system eksplisit: Sensors (lidar) dan Imu wajib ada,
         empty.sdf bawaan Gazebo tidak memuat keduanya. -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="walls">
      <static>true</static>
      <link name="link">
        <collision name="n"><pose>0 3 0.5 0 0 0</pose><geometry><box><size>8 0.1 1</size></box></geometry></collision>
        <visual name="n"><pose>0 3 0.5 0 0 0</pose><geometry><box><size>8 0.1 1</size></box></geometry></visual>
        <collision name="s"><pose>0 -3 0.5 0 0 0</pose><geometry><box><size>8 0.1 1</size></box></geometry></collision>
        <visual name="s"><pose>0 -3 0.5 0 0 0</pose><geometry><box><size>8 0.1 1</size></box></geometry></visual>
        <collision name="e"><pose>4 0 0.5 0 0 0</pose><geometry><box><size>0.1 6 1</size></box></geometry></collision>
        <visual name="e"><pose>4 0 0.5 0 0 0</pose><geometry><box><size>0.1 6 1</size></box></geometry></visual>
        <collision name="w"><pose>-4 0 0.5 0 0 0</pose><geometry><box><size>0.1 6 1</size></box></geometry></collision>
        <visual name="w"><pose>-4 0 0.5 0 0 0</pose><geometry><box><size>0.1 6 1</size></box></geometry></visual>
        <collision name="b1"><pose>2 1.5 0.5 0 0 0.4</pose><geometry><box><size>0.6 0.6 1</size></box></geometry></collision>
        <visual name="b1"><pose>2 1.5 0.5 0 0 0.4</pose><geometry><box><size>0.6 0.6 1</size></box></geometry></visual>
        <collision name="b2"><pose>-1.5 -1.8 0.5 0 0 0</pose><geometry><box><size>1.0 0.4 1</size></box></geometry></collision>
        <visual name="b2"><pose>-1.5 -1.8 0.5 0 0 0</pose><geometry><box><size>1.0 0.4 1</size></box></geometry></visual>
      </link>
    </model>
  </world>
</sdf>
