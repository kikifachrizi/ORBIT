<?xml version="1.0" ?>
<!-- Site Gedung P lantai 3 (97 x 34.2 m). Bangunan: models/gedung_P (model://gedung_P),
     mesh jendela dari orbit_sim/models (lihat models/ATTRIBUTION.md). -->
<sdf version="1.9">
  <world name="gedung_P">
    <!-- Step 4 ms: cukup untuk diff drive, beban CPU fisika ~4x lebih ringan dari 1 ms -->
    <physics name="4ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Daftar system eksplisit: Sensors (lidar) dan Imu wajib ada untuk sensor robot -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <!-- Sun Light / Cahaya Matahari -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground Plane / Lantai -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Include Model Gedung P -->
    <include>
      <uri>model://gedung_P</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

  </world>
</sdf>
