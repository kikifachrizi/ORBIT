<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>orbit_sim</name>
  <version>0.1.0</version>
  <description>Data site ORBIT: world Gazebo, model, peta Nav2, dan nav graph RMF per site, plus world.launch.py (Gazebo + /clock). Tidak berisi robot (ADR-004).</description>
  <maintainer email="kikifachrizi235@gmail.com">kikifachrizi</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <!-- building_map_generator: nav graph RMF dari <site>.building.yaml saat build -->
  <build_depend>rmf_building_map_tools</build_depend>

  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
