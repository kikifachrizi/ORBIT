<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>orbit_bringup</name>
  <version>0.1.0</version>
  <description>Konfigurasi dan peluncuran satu site ORBIT: inti RMF, satu orbit_adapter per fleet, dan (mode:=sim) Gazebo + robot (ADR-004).</description>
  <maintainer email="kikifachrizi235@gmail.com">kikifachrizi</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>orbit_adapter</exec_depend>
  <exec_depend>orbit_sim</exec_depend>
  <exec_depend>rmf_traffic_ros2</exec_depend>
  <exec_depend>rmf_task_ros2</exec_depend>
  <exec_depend>rmf_fleet_adapter</exec_depend>
  <exec_depend>rmf_building_map_tools</exec_depend>
  <exec_depend>rmf_visualization</exec_depend>
  <!-- Hanya mode:=sim -->
  <exec_depend>tifa_bringup</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
